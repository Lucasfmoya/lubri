rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /servicios/{doc} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.token.email != null
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.token.email)
        );
    }

  }
}