rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /campeon/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.token.email)
        );
    }
  }
}